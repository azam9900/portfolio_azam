# ============================================================
# Mohd Azam Portfolio — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# App
APP_NAME="Mohd Azam Portfolio API"
DEBUG=True
FRONTEND_URL=http://localhost:3000

# Database (SQLite for local dev, switch to PostgreSQL for production)
DATABASE_URL=sqlite:///./portfolio.db
# DATABASE_URL=postgresql://user:password@localhost:5432/portfolio_db

# JWT Auth
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin user (created on first run)
ADMIN_EMAIL=aa3981863@gmail.com
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=Mohd Azam

# Email (for contact form — uses Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aa3981863@gmail.com
SMTP_PASSWORD=your-gmail-app-password
CONTACT_RECEIVER=aa3981863@gmail.com
